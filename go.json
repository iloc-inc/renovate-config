{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "customManagers": [
    {
      "description": ".go-version の Go 本体バージョン",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.go-version$/"],
      "matchStrings": ["(?m)^(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)\\s*$"],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    },
    {
      "description": "go.mod の go / toolchain ディレクティブ",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)go\\.mod$/"],
      "matchStrings": [
        "(?m)^go (?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)$",
        "(?m)^toolchain go(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)$"
      ],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    },
    {
      "description": "go.work の toolchain ディレクティブ",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)go\\.work$/"],
      "matchStrings": ["(?m)^toolchain go(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)$"],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    },
    {
      "description": "docker-compose の golangci-lint イメージタグ",
      "customType": "regex",
      "managerFilePatterns": ["/^docker-compose\\.ya?ml$/"],
      "matchStrings": ["golangci/golangci-lint:v(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "description": "GitHub Actions の golangci-lint version 入力",
      "customType": "regex",
      "managerFilePatterns": ["/\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["version:\\s*v?(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],

  "postUpdateOptions": ["gomodTidy"],

  "packageRules": [
    {
      "matchDepNames": ["go"],
      "matchDatasources": ["golang-version"],
      "groupName": "go version"
    },
    {
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/^github\\.com\\/iloc-inc\\/go-common/"],
      "groupName": "go-common",
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": ["gomod"],
      "matchPackageNames": ["!/^github\\.com\\/iloc-inc\\/go-common/"],
      "groupName": "Go dependencies"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["golangci/golangci-lint"],
      "groupName": "golangci-lint dependencies"
    }
  ]
}
